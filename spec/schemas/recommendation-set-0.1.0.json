{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/open-gw/ctier/spec/schemas/recommendation-set-0.1.0.json",
  "title": "ctier recommendation set",
  "description": "An Overlay 1.1.0 document. Each action carries ctier extensions in update and provenance on the action. Provenance stays here; the qualified spec carries only x-ctier-status.",
  "type": "object",
  "additionalProperties": true,
  "required": ["ctierSchema", "overlay", "info", "actions"],
  "properties": {
    "ctierSchema": { "const": "recommendation-set/0.1.0" },
    "overlay": { "const": "1.1.0" },
    "info": {
      "type": "object",
      "required": ["title", "version"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "extends": { "type": "string" },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/action" }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": true,
      "required": ["target", "update", "x-ctier-provenance"],
      "properties": {
        "target": {
          "type": "string",
          "minLength": 1,
          "description": "RFC 9535 JSONPath selecting nodes in the description."
        },
        "description": { "type": "string" },
        "update": { "$ref": "#/$defs/update" },
        "remove": { "type": "boolean" },
        "copy": { "type": "string" },
        "x-ctier-provenance": { "$ref": "#/$defs/provenance" }
      }
    },
    "update": {
      "type": "object",
      "additionalProperties": true,
      "description": "Merged into each selected Operation Object. May carry any x-ctier-* operation-level key.",
      "properties": {
        "x-ctier-tier": {
          "$ref": "ctier-extensions-0.1.0.json#/$defs/tier"
        },
        "x-ctier-criteria": {
          "$ref": "ctier-extensions-0.1.0.json#/$defs/criteria"
        },
        "x-ctier-status": {
          "$ref": "ctier-extensions-0.1.0.json#/$defs/status"
        },
        "x-ctier-rationale": {
          "$ref": "ctier-extensions-0.1.0.json#/$defs/rationale"
        },
        "x-ctier-exclude": {
          "$ref": "ctier-extensions-0.1.0.json#/$defs/exclude"
        },
        "x-ctier-bounds": {
          "$ref": "ctier-extensions-0.1.0.json#/$defs/bounds"
        },
        "x-ctier-handoff": {
          "$ref": "ctier-extensions-0.1.0.json#/$defs/handoff"
        },
        "x-ctier-weight": {
          "$ref": "ctier-extensions-0.1.0.json#/$defs/weight"
        },
        "x-ctier-escalate-to": {
          "$ref": "ctier-extensions-0.1.0.json#/$defs/tier"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "inputText",
        "inputDigest",
        "source",
        "version",
        "confidence",
        "timestamp"
      ],
      "properties": {
        "inputText": {
          "type": "string",
          "description": "The description text the recommendation was derived from."
        },
        "inputDigest": {
          "$ref": "ctier-extensions-0.1.0.json#/$defs/digest"
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "description": "Rule id or model identifier."
        },
        "version": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    }
  }
}
